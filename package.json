    "@angular/router": "^22.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/status-bar": "^8.0.3",
    "@countrystatecity/countries-browser": "^1.0.4",
