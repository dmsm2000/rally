    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
